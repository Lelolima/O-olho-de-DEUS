# Variáveis de Ambiente - Template
# Copie para .env e preencha os valores
#
# Forma recomendada (gera JWT_SECRET, ENCRYPTION_KEY e OPERATOR_USERS com hash,
# pedindo a senha sem exibi-la):
#   python -m src.tools.bootstrap_env --operator admin --role admin

# ============================================
# SEGURANÇA E AUTENTICAÇÃO
# ============================================

# JWT Secret para autenticação (obrigatório em produção)
# Gere com: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=

# Chave de criptografia Fernet (base64, 32 bytes)
# Gere com: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# ============================================
# BANCO DE DADOS
# ============================================

# PostgreSQL (produção). Vazio = SQLite local (./olho_de_deus.db).
# Ex.: postgresql://olho:<senha>@localhost:5432/olho_de_deus
DATABASE_URL=

# USE_SQLITE=true força SQLite mesmo com DATABASE_URL definido
USE_SQLITE=false

# ============================================
# TIMESTAMP AUTHORITY (TSA)
# ============================================

# TSA para carimbo de tempo RFC 3161
# Opções:
#   - https://freetsa.org/tsr (gratuita, sem auth)
#   - http://timestamp.digicert.com
#   - http://timestamp.globalsign.com/tsa/r6advanced1
TSA_ENABLED=false
TSA_URL=https://freetsa.org/tsr

# ============================================
# ARMAZENAMENTO DE EVIDÊNCIAS
# ============================================

# Armazenamento local (desenvolvimento)
EVIDENCE_DIR=./forensic_logs

# AWS S3 (produção)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=olho-de-deus-evidence
AWS_REGION=us-east-1

# ============================================
# NOTIFICAÇÕES
# ============================================

# Webhook para alertas críticos
WEBHOOK_URL=https://api.example.com/alerts

# SMTP para envio de emails
SMTP_USER=usuario@example.com
SMTP_PASS=sua-senha-aqui
SMTP_SERVER=smtp.example.com
SMTP_PORT=587
SMTP_TLS=true

# ============================================
# LOGGING E DEBUG
# ============================================

# Nível de logging: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Debug mode (não usar em produção)
DEBUG=false

# ============================================
# API CONFIGURAÇÃO
# ============================================

# Host e porta da API
API_HOST=127.0.0.1
API_PORT=8000

# CORS origins (separado por vírgulas)
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
# Operadores HITL (obrigatório para login na API). JSON com hashes PBKDF2.
# Gere cada hash com: python -m src.cloud.api.middleware.auth "<senha>"
# Ex.: OPERATOR_USERS={"operador1": {"role": "operator", "password_hash": "pbkdf2_sha256$600000$..."}}
OPERATOR_USERS=
